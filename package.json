{
  "name": "node_lab1",
  "version": "1.0.0",
  "description": "Inventory API",
  "main": "app.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "imports": {
    "#controllers/*": "./controllers/*.js",
    "#routes/*": "./routes/*.js",
    "#utils/*": "./utils/*.js",
    "#config/*": "./config/*.js",
    "#validators/*": "./validators/*.js"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "predev": "npm run check"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
